# Primary deployment: AMD ROCm — use docker-compose.yml (or ./scripts/start.sh).
# NVIDIA: use docker-compose.cuda.yml and ./scripts/start_cuda.sh.
HF_TOKEN=
HF_HOME=/root/.cache/huggingface

# Public API is published on host port 8101 (fixed in docker-compose*.yml).
GATEWAY_PORT=8101
GATEWAY_TIMEOUT_SECONDS=600
GATEWAY_API_KEY=
GATEWAY_LOG_LEVEL=INFO
GATEWAY_RATE_LIMIT_RPM=120
GATEWAY_TRUST_X_FORWARDED_FOR=false
GATEWAY_CORS_ALLOWED_ORIGINS=

QWEN_MAIN_MODEL=Qwen/Qwen3.6-35B-A3B
QWEN_MAIN_ALIAS=qwen-main
QWEN_MAIN_TP=1
QWEN_MAIN_MAX_MODEL_LEN=32768
QWEN_MAIN_GPU_MEMORY_UTILIZATION=0.90
QWEN_MAIN_DTYPE=auto

CODER_MODEL=Qwen/Qwen3-Coder-Next
CODER_ALIAS=coder
CODER_TP=1
CODER_MAX_MODEL_LEN=32768
CODER_GPU_MEMORY_UTILIZATION=0.90
CODER_DTYPE=auto

DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2
DEEPSEEK_ALIAS=deepseek
DEEPSEEK_TP=1
DEEPSEEK_MAX_MODEL_LEN=32768
DEEPSEEK_GPU_MEMORY_UTILIZATION=0.90
DEEPSEEK_DTYPE=auto

BGE_MODEL=BAAI/bge-large-en-v1.5
BGE_ALIAS=bge-large
BGE_TP=1
BGE_MAX_MODEL_LEN=8192
BGE_GPU_MEMORY_UTILIZATION=0.25
BGE_DTYPE=auto

# ROCm (docker-compose.yml): **per-backend** GPU index. Each must exist on the host (rocm-smi).
# Invalid indices (e.g. 1–3 on a 1-GPU host) → vLLM "No HIP GPUs" → gateway 502 upstream errors.
# Default compose starts **qwen-main only**. All backends: docker compose --profile full-stack up -d
QWEN_MAIN_HIP_VISIBLE_DEVICES=0
CODER_HIP_VISIBLE_DEVICES=1
DEEPSEEK_HIP_VISIBLE_DEVICES=2
BGE_HIP_VISIBLE_DEVICES=3
# Do **not** set HSA_OVERRIDE_GFX_VERSION to an empty value (e.g. `HSA_OVERRIDE_GFX_VERSION=`) — that breaks
# ROCm in-container (`HSA_STATUS_ERROR_OUT_OF_RESOURCES`, PyTorch "No HIP GPUs"). Omit entirely unless you need
# a real override for your ASIC (see AMD ROCm docs). Optional: put overrides in `docker-compose.override.yml`.
#
# HSA_OVERRIDE_GFX_VERSION=11.0.0

# NVIDIA (docker-compose.cuda.yml): per-backend visible CUDA devices (defaults assume four GPUs).
QWEN_MAIN_CUDA_VISIBLE_DEVICES=0
CODER_CUDA_VISIBLE_DEVICES=1
DEEPSEEK_CUDA_VISIBLE_DEVICES=2
BGE_CUDA_VISIBLE_DEVICES=3
