# Primary deployment: AMD ROCm — use docker-compose.yml (or ./scripts/start.sh).
# NVIDIA: use docker-compose.cuda.yml and ./scripts/start_cuda.sh.
HF_TOKEN=
HF_HOME=/root/.cache/huggingface

# Public API is published on host port 8101 (fixed in docker-compose*.yml).
GATEWAY_PORT=8101
GATEWAY_TIMEOUT_SECONDS=600
GATEWAY_API_KEY=
GATEWAY_LOG_LEVEL=INFO
GATEWAY_RATE_LIMIT_RPM=120
GATEWAY_TRUST_X_FORWARDED_FOR=false
GATEWAY_CORS_ALLOWED_ORIGINS=

QWEN_MAIN_MODEL=Qwen/Qwen3.6-35B-A3B
QWEN_MAIN_ALIAS=qwen-main
QWEN_MAIN_TP=1
QWEN_MAIN_MAX_MODEL_LEN=32768
QWEN_MAIN_GPU_MEMORY_UTILIZATION=0.90
QWEN_MAIN_DTYPE=auto

CODER_MODEL=Qwen/Qwen3-Coder-Next
CODER_ALIAS=coder
CODER_TP=1
CODER_MAX_MODEL_LEN=32768
CODER_GPU_MEMORY_UTILIZATION=0.90
CODER_DTYPE=auto

DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2
DEEPSEEK_ALIAS=deepseek
DEEPSEEK_TP=1
DEEPSEEK_MAX_MODEL_LEN=32768
DEEPSEEK_GPU_MEMORY_UTILIZATION=0.90
DEEPSEEK_DTYPE=auto

BGE_MODEL=BAAI/bge-large-en-v1.5
BGE_ALIAS=bge-large
BGE_TP=1
BGE_MAX_MODEL_LEN=8192
BGE_GPU_MEMORY_UTILIZATION=0.25
BGE_DTYPE=auto

CUDA_VISIBLE_DEVICES=0,1,2,3
HIP_VISIBLE_DEVICES=0,1,2,3
HSA_OVERRIDE_GFX_VERSION=
